      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Revenue By Country",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cg0mvj6anutj4d"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.22.1",
                        "queryType": "table",
                        "rawSql": "select o.ship_country as country,sum(od.unit_price*od.quantity*(1-od.discount)) as Revenue from northwind.order_details as od \r\njoin northwind.orders as o \r\non od.order_id=o.order_id\r\ngroup by o.ship_country \r\nORDER BY Revenue DESC\r\n\r\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
